{
  "name": "ashen-grimoire",
  "version": "0.1.0",
  "description": "A turn-based dark fantasy spell-forging tactics game.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "server": "tsx server/index.ts",
    "electron": "npm run build && electron .",
    "electron:dev": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dist": "npm run build && electron-builder",
    "balance": "tsx scripts/balance.ts",
    "play": "vite build && tsx server/index.ts"
  },
  "dependencies": {
    "@fontsource/im-fell-english": "5.3.0",
    "@fontsource/pirata-one": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "pixi.js": "8.23.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "8.18.2",
    "cross-env": "^7.0.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "com.ashengrimoire.game",
    "productName": "Ashen Grimoire",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}